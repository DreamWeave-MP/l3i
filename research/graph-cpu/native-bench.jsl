for _,n in {1024,65536} do
 local a,b,out,two=buffer.create(n*4),buffer.create(n*4),buffer.create(n*4),buffer.create(n*4)
 for i=0,n-1 do buffer.writef32(a,i*4,i%101-50); buffer.writef32(b,i*4,i%13-6); buffer.writef32(two,i*4,2) end
 local plan=compute.slot(0,1,n):add(compute.slot(1,1,n)):add(compute.constant(2)):relu():compile()
 local start=compute.clock(); local native=plan:native(); local compile=(compute.clock()-start)*1e6
 local inputs={a,b}
 start=compute.clock(); native(inputs,out); local first=(compute.clock()-start)*1e6
 start=compute.clock(); for _=1,100 do native(inputs,out) end; local warm=(compute.clock()-start)*1e6/100
 for i=0,n-1 do assert(buffer.readf32(out,i*4)==math.max(i%101-50+i%13-6+2,0)) end
 start=compute.clock()
 for _=1,100 do data.add(a,'f32',0,b,0,out,0,n); data.add(out,'f32',0,two,0,out,0,n); data.clamp(out,'f32',0,n,0,math.huge,out,0) end
 local data_us=(compute.clock()-start)*1e6/100
 print(string.format('native_graph_n=%d compile_us=%.3f first_us=%.3f warm_preallocated_us=%.3f data_preallocated_us=%.3f',n,compile,first,warm,data_us))
end
