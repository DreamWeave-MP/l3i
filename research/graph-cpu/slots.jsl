local n=256
local x,y=compute.slot(0,1,n),compute.slot(1,1,n)
local program=x:add(y):add(compute.constant(2)):relu():compile()
local native=program:native()
assert(not pcall(function() program:shader_source('strict') end))
local factory=program:shader_source('integer-exact')
local testSource='local make=(function()\n'..factory..'\nend)()\nlocal run=make(jess.gpu.device())\n'
for seed=1,3 do
 local a,b,out,direct=buffer.create(n*4),buffer.create(n*4),buffer.create(n*4),buffer.create(n*4)
 for i=0,n-1 do buffer.writef32(a,i*4,(i+seed)%101-50); buffer.writef32(b,i*4,(i*seed)%13-6) end
 local ta,tb=compute.f32(a,1,n),compute.f32(b,1,n)
 local expected=program:runReference(ta,tb):read()
 local chunked=program:run(ta,tb):read()
 native({a,b},out)
 program:runInto(direct,a,b)
 local values={}
 for i=0,n-1 do
  local e=buffer.readf32(expected,i*4)
  assert(buffer.readf32(chunked,i*4)==e and buffer.readf32(out,i*4)==e and buffer.readf32(direct,i*4)==e)
  values[i+1]=tostring(e)
 end
 testSource..=string.format([[do
local a,b=buffer.create(%d),buffer.create(%d)
for i=0,%d do buffer.writef32(a,i*4,(i+%d)%%101-50); buffer.writef32(b,i*4,(i*%d)%%13-6) end
local expected={%s}
local result=run({a,b})
for i,v in expected do assert(buffer.readf32(result,(i-1)*4)==v,`shader mismatch {i}`) end
end
]],n*4,n*4,n-1,seed,seed,table.concat(values,','))
end
shared.state.shader_artifact=testSource.."print('same graph: CPU oracle, chunked kernels, Luau native and Jess shader verified across three input sets')\n"
print('rebindable graph verified across the reference, chunked and generated native executors')
-- Strict native f32 edge cases must match the reference bitwise, except NaN payloads.
do
 local p=compute.slot(0,1,8):relu():compile()
 local kernel=p:native()
 local a,out,direct=buffer.create(32),buffer.create(32),buffer.create(32)
 local bits={0,0x80000000,1,0x80000001,0x7f800000,0xff800000,0x7fc00001,0x3f800001}
 for i,v in bits do buffer.writeu32(a,(i-1)*4,v) end
 local t=compute.f32(a,1,8)
 local expected=p:runReference(t):read();kernel({a},out);p:runInto(direct,a)
 for i=0,7 do local x,y,z=buffer.readf32(out,i*4),buffer.readf32(expected,i*4),buffer.readf32(direct,i*4)
  assert((x~=x and y~=y) or buffer.readu32(out,i*4)==buffer.readu32(expected,i*4))
  assert((z~=z and y~=y) or buffer.readu32(direct,i*4)==buffer.readu32(expected,i*4))
 end
 local a,b,out=buffer.create(4),buffer.create(4),buffer.create(4)
 buffer.writeu32(a,0,0x3f800001); buffer.writeu32(b,0,0x3f7ffffe)
 local p=compute.slot(0,1,1):mul(compute.slot(1,1,1)):add(compute.constant(-1)):compile()
 p:native()({a,b},out)
 assert(buffer.readu32(out,0)==0,'native FMA/rounding mismatch')
 p:runInto(out,a,b)
 assert(buffer.readu32(out,0)==0,'chunked FMA/rounding mismatch')
end

do
 local input=buffer.create(24)
 for i=0,5 do buffer.writef32(input,i*4,i+1) end
 local x=compute.slot(0,2,3)
 local p=x:sumRows():add(compute.constant(2)):compile()
 local out=buffer.create(8)
 p:runInto(out,input)
 assert(buffer.readf32(out,0)==8 and buffer.readf32(out,4)==17)
 local t=compute.f32(input,2,3)
 local actual,reference=p:run(t):read(),p:runReference(t):read()
 for i=0,1 do assert(buffer.readf32(actual,i*4)==buffer.readf32(reference,i*4)) end
 assert(not pcall(function() p:runInto(input,input) end))
 local empty=compute.slot(0,3,0):sumRows():compile()
 local zeros=buffer.create(12)
 empty:runInto(zeros,buffer.create(0))
 for i=0,2 do assert(buffer.readf32(zeros,i*4)==0) end
end

do
 local input=buffer.create(24)
 local logits={1,2,3,math.huge,0,math.huge}
 for i,v in logits do buffer.writef32(input,(i-1)*4,v) end
 local x=compute.slot(0,2,3)
 local p=x:softmax():compile()
 local out=buffer.create(24)
 p:runInto(out,input)
 local reference=p:runReference(compute.f32(input,2,3)):read()
 for i=0,5 do assert(buffer.readf32(out,i*4)==buffer.readf32(reference,i*4)) end
 assert(buffer.readf32(out,12)==0.5 and buffer.readf32(out,16)==0 and buffer.readf32(out,20)==0.5)
 local summed=x:softmax():sumRows():compile()
 local sums=buffer.create(8)
 summed:runInto(sums,input)
 for i=0,1 do assert(math.abs(buffer.readf32(sums,i*4)-1)<1e-6) end
 compute.slot(0,3,0):softmax():compile():runInto(buffer.create(0),buffer.create(0))
end
