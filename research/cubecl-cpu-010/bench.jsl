-- All numbers include the JSL/native crossing. CubeCL includes copies and readback.
for _, n in {1024, 65536} do
  local a, b, out = buffer.create(n * 4), buffer.create(n * 4), buffer.create(n * 4)
  for i = 0, n - 1 do
    buffer.writef32(a, i * 4, i % 17)
    buffer.writef32(b, i * 4, i % 13)
  end
  local started = clock()
  local cold = run_expression('+', a, b)
  local first = (clock() - started) * 1e6
  assert(buffer.readf32(cold, 4) == 2)
  local reps = 10
  started = clock()
  for _ = 1, reps do run_expression('+', a, b) end
  local cube = (clock() - started) * 1e6 / reps
  started = clock()
  for _ = 1, reps do native_add(a, b) end
  local native = (clock() - started) * 1e6 / reps
  started = clock()
  for _ = 1, reps do data.add(a, 'f32', 0, b, 0, out, 0, n) end
  local bulk = (clock() - started) * 1e6 / reps
  assert(buffer.readf32(out, 4) == 2)
  print(`n={n} first_us={first} cube_warm_us={cube} rust_copy_us={native} data_preallocated_us={bulk}`)
end
