-- A tiny JSL-authored expression DSL. Operations are compiled into a CubeCL kernel.
local expression = '*' .. '2' .. 'r' -- a * b, add 2, then relu
local a, b = buffer.create(16), buffer.create(16)
for i = 0, 3 do
  buffer.writef32(a, i * 4, i - 2)
  buffer.writef32(b, i * 4, i + 1)
end
local result = run_expression(expression, a, b)
local expected = { 0, 0, 2, 6 }
for i = 0, 3 do
  assert(buffer.readf32(result, i * 4) == expected[i + 1])
end
local other = run_expression('+2', a, b)
for i = 0, 3 do
  assert(buffer.readf32(other, i * 4) == (i - 2) + (i + 1) + 2)
end
print('two JSL-authored expressions verified')
local empty = run_expression('*', buffer.create(0), buffer.create(0))
assert(buffer.len(empty) == 0)
assert(not pcall(run_expression, '', a, b))
assert(not pcall(run_expression, 'x', a, b))
assert(not pcall(run_expression, '*', a, buffer.create(12)))
assert(not pcall(run_expression, '*', buffer.create(3), buffer.create(3)))
assert(not pcall(run_expression, string.rep('*', 33), a, b))
local square = run_expression('*', a, a)
for i = 0, 3 do
  assert(buffer.readf32(square, i * 4) == (i - 2) * (i - 2))
end
local repeated = run_expression(expression, a, b)
assert(buffer.readf32(repeated, 12) == 6)
print('invalid inputs, empty buffers, aliasing and repeated execution verified')
local special = buffer.create(16)
buffer.writef32(special, 0, 0/0)
buffer.writef32(special, 4, math.huge)
buffer.writef32(special, 8, -math.huge)
buffer.writef32(special, 12, -0.0)
local activated = run_expression('r', special, special)
assert(buffer.readf32(activated, 0) ~= buffer.readf32(activated, 0))
assert(buffer.readf32(activated, 4) == math.huge)
assert(buffer.readf32(activated, 8) == 0)
assert(buffer.readf32(activated, 12) == 0 and 1 / buffer.readf32(activated, 12) == math.huge)
print('NaN, infinities and zero verified')
local ma, mb = buffer.create(24), buffer.create(24)
for i = 0, 5 do
  buffer.writef32(ma, i * 4, i + 1)
  buffer.writef32(mb, i * 4, i + 7)
end
local product = matmul(ma, mb, 2, 2, 3)
for row = 0, 1 do
  for col = 0, 1 do
    local expected = 0
    for k = 0, 2 do
      expected += buffer.readf32(ma, (row * 3 + k) * 4) * buffer.readf32(mb, (k * 2 + col) * 4)
    end
    assert(buffer.readf32(product, (row * 2 + col) * 4) == expected)
  end
end
assert(not pcall(matmul, ma, mb, -1, 2, 3))
assert(not pcall(matmul, ma, mb, 3, 2, 3))
assert(not pcall(matmul, ma, mb, 4294967295, 4294967295, 3))
local zero = matmul(buffer.create(0), buffer.create(0), 2, 3, 0)
assert(buffer.len(zero) == 24 and buffer.readf32(zero, 20) == 0)
print('matrix product, empty reduction, invalid shapes and overflow verified')
-- Compare against an independently rounded f32 intermediate and final result.
local ra, rb, scratch = buffer.create(4), buffer.create(4), buffer.create(4)
buffer.writef32(ra, 0, 1.0000001192092896)
buffer.writef32(rb, 0, 1.0000001192092896)
buffer.writef32(scratch, 0, buffer.readf32(ra, 0) * buffer.readf32(rb, 0))
buffer.writef32(scratch, 0, buffer.readf32(scratch, 0) + 2)
local rounded = run_expression('*2', ra, rb)
assert(buffer.readf32(rounded, 0) == buffer.readf32(scratch, 0))
assert(buffer.readf32(ra, 0) == buffer.readf32(rb, 0))
print('f32 rounding and input preservation verified')
-- Strided reads and scalar broadcasting copy from possibly aliased Luau buffers.
local records = buffer.create(32)
for i = 0, 3 do buffer.writef32(records, i * 8, i + 1) end
local viewed = run_strided('+', records, records, 0, 8, 8, 0, 4)
for i = 0, 3 do assert(buffer.readf32(viewed, i * 4) == i + 3) end
assert(buffer.len(run_strided('+', records, records, 32, 8, 32, 0, 0)) == 0)
assert(not pcall(run_strided, '+', records, records, 1, 16, 0, 0, 4))
assert(not pcall(run_strided, '+', records, records, -1, 4, 0, 0, 1))
assert(not pcall(run_strided, '+', records, records, 0, 9223372036854775807, 0, 0, 3))
assert(buffer.readf32(records, 0) == 1)
print('strided views, broadcast, invalid bounds and alias preservation verified')
assert(not pcall(run_strided, '+', records, records, 0, 0, 0, 0, 1048577))
-- Zero-inner matrices used to allocate an unbounded result despite having empty inputs.
local ok, why = pcall(matmul, buffer.create(0), buffer.create(0), 1048577, 1, 0)
assert(not ok and string.find(why, 'budget', 1, true))
local edge = matmul(buffer.create(0), buffer.create(0), 1024, 1024, 0)
assert(buffer.len(edge) == 4194304 and buffer.readf32(edge, 4194300) == 0)
-- Exhaust new specializations; already admitted programs must remain usable after refusal.
local exhausted = false
for i = 1, 32 do
  local good, problem = pcall(run_expression, string.rep('2', i), ra, rb)
  if not good then
    assert(string.find(problem, 'specialization budget exhausted', 1, true), problem)
    exhausted = true
    break
  end
end
assert(exhausted)
assert(buffer.readf32(run_expression('*2r', a, b), 12) == 6)
print('matrix allocation budget and specialization exhaustion recovery verified')
local oversized = buffer.create(4194308)
local good, issue = pcall(run_expression, '+', oversized, oversized)
assert(not good and string.find(issue, 'allocation budget exceeded', 1, true))
local long = buffer.create(1024 * 17 * 4)
good, issue = pcall(matmul, long, long, 1024, 1024, 17)
assert(not good and string.find(issue, 'matrix resource budget exceeded', 1, true))
local one = buffer.create(4)
good, issue = pcall(matmul, one, one, 1, 1, 1)
assert(not good and string.find(issue, 'specialization budget exhausted', 1, true))
assert(buffer.readf32(matmul(ma, mb, 2, 2, 3), 0) == 58)
print('input, matrix work, and shared compilation budgets verified')
