-- Full borrowed-buffer JSL invocation, prepared input and output.
for _, n in {1,16,1024,65536,1048576} do
 local input,out=buffer.create(n*4),buffer.create(4)
 local expected=0
 for i=0,n-1 do
  local v=i%127*0.125-8
  buffer.writef32(input,i*4,v)
  expected+=v
 end
 local p=compute.slot(0,1,n):sumRows():compile()
 p:runInto(out,input)
 -- These dyadic fixtures stay exactly representable during the ordered sum.
 assert(buffer.readf32(out,0)==expected)
 local iterations=1
 while true do
  local start=testing.clock()
  for _=1,iterations do p:runInto(out,input) end
  if testing.clock()-start>=0.003 then break end
  iterations*=2
 end
 local samples={}
 for i=1,31 do
  local start=testing.clock()
  for _=1,iterations do p:runInto(out,input) end
  samples[i]=(testing.clock()-start)*1e6/iterations
 end
 table.sort(samples)
 print(string.format('jsl_ordered_sum_runInto n=%d median_us=%.3f min_us=%.3f p90_us=%.3f',n,samples[16],samples[1],samples[28]))
end
